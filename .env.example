# ---------------------------------------------------------------------------
# Synapse configuration. Copy to `.env` (never commit it).
# Everything works with the defaults below (mock mode, no keys).
# ---------------------------------------------------------------------------

# --- Core
NODE_ENV=development
PORT=8787
WEB_PORT=5173
DATA_DIR=./data
TIMEZONE=Asia/Kolkata
USER_FIRST_NAME=Rio
USER_ROLE=backend engineer
# name:role pairs the cortex can use to resolve people ("what did Sarah say?")
USER_TEAM=Sarah:PM,Dev:SRE
HACKATHON_START=2026-10-06T09:00:00+05:30

# --- Wispr Flow (get a key at https://platform.wisprflow.ai -> API Keys; access is by approval)
# client = browser streams straight to Wispr with short-lived JWTs (recommended, audio never touches this server)
# proxy  = browser -> this server -> Wispr (use only if client tokens are unavailable)
# local  = no Wispr and no cloud: on-device Whisper on the machine that runs this server (no key needed; see STT_* below).
#          This is the default here, so a fresh clone has a working voice path. Switch to client once you have a Wispr key.
# mock   = no Wispr; use typed input / replays (also what the server does when there is no .env at all)
WISPR_MODE=local
WISPR_API_KEY=
WISPR_BASE=https://platform-api.wisprflow.ai/api/v1/dash
# comma separated ISO 639-1 codes; empty = auto-detect (e.g. en,hi for Hinglish)
WISPR_LANGUAGES=en
WISPR_TOKEN_TTL_SECS=900
WISPR_FINAL_TIMEOUT_MS=4000
WISPR_STANDBY_MAX_AGE_MS=45000
WISPR_WARMUP_INTERVAL_S=120

# --- On-device speech to text (Whisper through transformers.js, CPU, English). Used by WISPR_MODE=local, by local-only mode
# (Privacy Center) while a Wispr setup is configured, and by STT_FALLBACK. The audio then goes browser -> this server, is held in
# memory for one utterance, transcribed and zeroed; it is never written anywhere. The model downloads once (about 40 MB) into data/models.
STT_MODEL=Xenova/whisper-tiny.en
STT_DTYPE=q8
# 1 = load the model at start, 0 = on first use, auto = at start when WISPR_MODE=local
STT_PRELOAD=auto
# 1 = when Wispr rejects the key or cannot be reached, transcribe on this machine instead of failing (off by default: with Wispr
# configured, audio otherwise never reaches this server)
STT_FALLBACK=0
# Sarvam AI speech-to-text (CLOUD, good for Indian accents/Hinglish): WISPR_MODE=sarvam or STT_PROVIDER=sarvam, plus a key.
# Local-only mode always uses on-device Whisper instead. Each call is recorded in the audit ledger (length only).
STT_PROVIDER=whisper
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_STT_MODEL=saaras:v4
SARVAM_LANGUAGE=auto

# --- LLM (live mode needs a key for the provider in use; mock = deterministic local cortex, no network)
# Only the server follows this. `pnpm seed`, `pnpm replay --local` and `pnpm eval` / `pnpm bench` without --live always use the offline cortex.
LLM_MODE=mock
# auto: Anthropic when ANTHROPIC_API_KEY is set, else Groq when GROQ_API_KEY is set, else mock.
# anthropic | groq force one (groq without GROQ_API_KEY stays mock). LLM_MODE=mock and LOCAL_ONLY=1 always win.
LLM_PROVIDER=auto

# --- Claude (the default provider; needs ANTHROPIC_API_KEY, or `ant auth login`)
ANTHROPIC_API_KEY=
# hot path: must stay under ~1s, so a small fast model
MODEL_FAST=claude-haiku-4-5
# recall synthesis, session brief, consolidation
MODEL_DEEP=claude-opus-5-5

# --- Groq (alternative provider, OpenAI-compatible; key at https://console.groq.com/keys)
# The free tier allows 8,000 tokens per minute and 1,000 requests per day, and a request whose prompt alone exceeds the
# minute budget is rejected. So the live cortex sends a compact prompt (cortex/prompts-lite.ts) and paces itself: a burst
# waits briefly for the budget, then degrades to the local cortex instead of earning a 429.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
# hot path: best of three on a live comparison (accuracy and ~1 s a call); reasoning_effort low is added for gpt-oss models
GROQ_MODEL_FAST=qwen/qwen3.8-27b
# recall synthesis, session brief, consolidation (reasoning_effort medium). A different model on purpose: Groq meters tokens per
# model, so a capture burst that empties the hot path's minute does not starve a recall answer.
GROQ_MODEL_DEEP=openai/gpt-oss-120b
# how the cortex asks for JSON: auto (= json_object, the measured default) | json_object | json_schema (strict decoding; on gpt-oss
# it costs about 1.5k prompt tokens per call) | text (no response_format: the only mode in which Groq streams tokens, so cards
# type in; Groq then no longer guarantees JSON syntax, zod and one repair retry still apply)
GROQ_OUTPUT_MODE=auto
# tokens per minute to pace to (stay under the plan's 8,000)
GROQ_TPM=7000
# longest a call may queue for that budget before it degrades to the local cortex
GROQ_MAX_WAIT_MS=2000
# a whole capture (phone upload, capture box) is drafted in ONE call and may wait this long for the budget (the live mic keeps the 2 s above)
GROQ_CAPTURE_MAX_WAIT_MS=25000
# local safety cap on requests per UTC day (the free tier allows 1,000); 0 = no cap
GROQ_MAX_REQUESTS_PER_DAY=900

# --- Embeddings (local, ONNX, runs on CPU). hash = offline lexical fallback
EMBEDDINGS=model
# MiniLM (English, 23 MB, well-spread similarities) is the default.
# Xenova/multilingual-e5-small is supported (118 MB, ~100 languages).
EMBED_MODEL=Xenova/all-MiniLM-L6-v2
# where the downloaded model is cached (default ./data). Pre-download once with: pnpm --filter @synapse/server warm-models
MODEL_CACHE_DIR=

# --- Memory & privacy
# optional: derive the master key from a passphrase; otherwise a random keyfile is created in DATA_DIR
SYNAPSE_PASSPHRASE=
WORKING_MEMORY_TTL_HOURS=72
PROMOTE_THRESHOLD=0.6
PAUSE_PURGE_WINDOW_SECS=30
# disables all cloud LLM calls (heuristics only)
LOCAL_ONLY=0
# localhost is always exempt
REQUIRE_PAIRING=1
PSEUDONYMIZE_PERSONS=0
CONSOLIDATE_INTERVAL_MIN=10
THREAD_CLOSE_MS=6000

# --- Proactivity
# 0 observe, 1 draft, 2 stage (default), 3 execute private/reversible/self-only actions
AUTONOMY_LEVEL=2
RECURRING_N=3
RECURRING_WINDOW_MIN=10
# minimum gap between proactive suggestions (seconds); lower it for demos
SUGGESTION_MIN_GAP_S=120

# --- Remote access (V1): your phone reaches this Mac over the internet through a cloudflared tunnel
# the passphrase you type once on each device (sessions last 90 days); required before a tunnel will start
SYNAPSE_PASSCODE=
# set automatically by TUNNEL=1; set it yourself for a named tunnel or reverse proxy (https://synapse.example.com)
PUBLIC_URL=
# 1 = start a cloudflared quick tunnel with `pnpm start` and print its URL plus a QR code (brew install cloudflared)
TUNNEL=0
# serve the built web app from the API server (one origin, one port): auto = when apps/web/dist exists
SERVE_WEB=auto

# --- Integrations (all optional; without them the outbox simulates)
# token can come from `gh auth token`
GITHUB_TOKEN=
# owner/repo, use a private sandbox repo
GITHUB_REPO=
# V1: a throwaway private repo for real issue tests (gh repo create synapse-sandbox --private); the first default repo
GITHUB_SANDBOX_REPO=
# the GitHub REST API base (only change it for a GitHub Enterprise server or a test fake)
GITHUB_API_URL=https://api.github.com
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
