# ---------------------------------------------------------------------------
# Synapse configuration. Copy to `.env` (never commit it).
# Everything works with the defaults below (mock mode, no keys).
# ---------------------------------------------------------------------------

# --- Core
NODE_ENV=development
PORT=8787
WEB_PORT=5173
DATA_DIR=./data
TIMEZONE=Asia/Kolkata
USER_FIRST_NAME=Rio
USER_ROLE=backend engineer
# name:role pairs the cortex can use to resolve people ("what did Sarah say?")
USER_TEAM=Sarah:PM,Dev:SRE
HACKATHON_START=2026-10-06T09:00:00+05:30

# --- Wispr Flow (get a key at https://platform.wisprflow.ai -> API Keys; access is by approval)
# client = browser streams straight to Wispr with short-lived JWTs (recommended, audio never touches this server)
# proxy  = browser -> this server -> Wispr (use only if client tokens are unavailable)
# mock   = no Wispr; use typed input / replays
WISPR_MODE=mock
WISPR_API_KEY=
WISPR_BASE=https://platform-api.wisprflow.ai/api/v1/dash
# comma separated ISO 639-1 codes; empty = auto-detect (e.g. en,hi for Hinglish)
WISPR_LANGUAGES=en
WISPR_TOKEN_TTL_SECS=900
WISPR_FINAL_TIMEOUT_MS=4000
WISPR_STANDBY_MAX_AGE_MS=45000
WISPR_WARMUP_INTERVAL_S=120

# --- Claude (live mode needs ANTHROPIC_API_KEY, or `ant auth login`)
LLM_MODE=mock
ANTHROPIC_API_KEY=
# hot path: must stay under ~1s, so a small fast model
MODEL_FAST=claude-haiku-4-5
# recall synthesis, session brief, consolidation
MODEL_DEEP=claude-opus-5-5

# --- Embeddings (local, ONNX, runs on CPU). hash = offline lexical fallback
EMBEDDINGS=model
# MiniLM (English, 23 MB, well-spread similarities) is the default.
# Xenova/multilingual-e5-small is supported (118 MB, ~100 languages).
EMBED_MODEL=Xenova/all-MiniLM-L6-v2
# where the downloaded model is cached (default ./data). Pre-download once with: pnpm --filter @synapse/server warm-models
MODEL_CACHE_DIR=

# --- Memory & privacy
# optional: derive the master key from a passphrase; otherwise a random keyfile is created in DATA_DIR
SYNAPSE_PASSPHRASE=
WORKING_MEMORY_TTL_HOURS=72
PROMOTE_THRESHOLD=0.6
PAUSE_PURGE_WINDOW_SECS=30
# disables all cloud LLM calls (heuristics only)
LOCAL_ONLY=0
# localhost is always exempt
REQUIRE_PAIRING=1
PSEUDONYMIZE_PERSONS=0
CONSOLIDATE_INTERVAL_MIN=10
THREAD_CLOSE_MS=6000

# --- Proactivity
# 0 observe, 1 draft, 2 stage (default), 3 execute private/reversible/self-only actions
AUTONOMY_LEVEL=2
RECURRING_N=3
RECURRING_WINDOW_MIN=10
# minimum gap between proactive suggestions (seconds); lower it for demos
SUGGESTION_MIN_GAP_S=120

# --- Integrations (all optional; without them the outbox simulates)
# token can come from `gh auth token`
GITHUB_TOKEN=
# owner/repo, use a private sandbox repo
GITHUB_REPO=
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
